<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fonts -->
    <style name="CircularRegularFont">
        <item name="android:fontFamily">@font/circular_pro_regular</item>
    </style>
    <style name="CircularMediumFont">
        <item name="android:fontFamily">@font/circular_pro_medium</item>
    </style>
    <style name="CircularBoldFont">
        <item name="android:fontFamily">@font/circular_pro_bold</item>
    </style>
    <style name="CircularBookFont">
        <item name="android:fontFamily">@font/circular_pro_boo</item>
    </style>

    <style name="RoundBlueButtonTextStyle">
        <item name="android:fontFamily">@font/circular_pro_medium</item>
        <item name="android:textSize">@dimen/round_blue_button_text_size</item>
    </style>

    <style name="onboardSpinnerItemStyle">
        <!--        <item name="android:textColor">#000000</item>-->
        <item name="android:textColor">@color/kamleon_dark_grey</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Button styles -->
    <style name="Button" />
    <style name="Button.Kamleon">
        <item name="android:fontFamily">@font/circular_pro_medium</item>
        <item name="android:textSize">@dimen/round_blue_button_text_size</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Button.Kamleon.Primary">
        <item name="android:background">@drawable/bg_btn_round_blue</item>
        <item name="android:textColor">@drawable/color_text_button_blue_round</item>
        <item name="shapeAppearanceOverlay">@style/capsuleShape</item>


    </style>
    <style name="capsuleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Theme styles -->
    <style name="Circular" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/circular_pro_regular</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Circular.Inverse">
        <item name="android:textColor">?attr/colorOnSurfaceInverse</item>
    </style>
    <style name="Circular.Regular">
        <item name="android:fontFamily">@font/circular_pro_regular</item>
    </style>
    <style name="Circular.Medium">
        <item name="android:fontFamily">@font/circular_pro_medium</item>
    </style>
    <style name="Circular.Bold">
        <item name="android:fontFamily">@font/circular_pro_bold</item>
    </style>
    <style name="Circular.Book">
        <item name="android:fontFamily">@font/circular_pro_boo</item>
    </style>


    <style name="TextAppearance" />
    <style name="TextAppearance.Kamleon">
        <item name="fontFamily">@font/circular_pro</item>
        <item name="android:fontFamily">@font/circular_pro</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Kamleon.Regular">
        <item name="android:fontFamily">@font/circular_pro_regular</item>
    </style>
    <style name="TextAppearance.Kamleon.Medium">
        <item name="fontFamily">@font/circular_pro_medium</item>
        <item name="android:fontFamily">@font/circular_pro_medium</item>
    </style>
    <style name="TextAppearance.Kamleon.Bold">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/circular_pro_bold</item>
    </style>
    <style name="TextAppearance.Kamleon.Book">
        <item name="android:fontFamily">@font/circular_pro_boo</item>
    </style>
    <!-- Headline3: 48sp -->
    <style name="TextAppearance.Kamleon.Headline3">
        <item name="android:textSize">@dimen/ts_45</item>
    </style>
    <!-- Headline4: 34sp -->
    <style name="TextAppearance.Kamleon.Headline4">
        <item name="android:textSize">@dimen/ts_36</item>
    </style>
    <!-- Headline5: 24sp -->
    <style name="TextAppearance.Kamleon.Headline5">
        <item name="android:fontFamily">@font/circular_pro_boo</item>
        <item name="android:textSize">@dimen/ts_24</item>
    </style>
    <!-- Headline6: 20sp -->
    <style name="TextAppearance.Kamleon.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/ts_20</item>
    </style>
    <!-- Subtitle1: 16sp -->
    <style name="TextAppearance.Kamleon.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/ts_16</item>
    </style>
    <!-- Body1: 16sp -->
    <style name="TextAppearance.Kamleon.Body1">
        <item name="android:textSize">@dimen/ts_16</item>
    </style>
    <!-- Body2: 14sp -->
    <style name="TextAppearance.Kamleon.Body2">
        <item name="android:textSize">@dimen/ts_14</item>
    </style>
    <!-- Button: 14sp -->
    <style name="TextAppearance.Kamleon.Button">
        <item name="android:textSize">@dimen/ts_16</item>
    </style>
    <!-- Overline: 10sp -->
    <style name="TextAppearance.Kamleon.Overline">
        <item name="android:textSize">@dimen/ts_10</item>
    </style>





    <!-- Round white button in a screen header (back, notifications), with the avatar's soft shadow. -->
    <style name="Widget.Kamleon.HeaderButton" parent="CardView">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- The back chevron filling a HeaderButton, so the whole circle takes the tap; drawn a little left of centre. -->
    <style name="Widget.Kamleon.HeaderButton.Back" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_arrow_back_ios_new_24</item>
        <item name="tint">@color/kamleon_dark_grey</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- An option row of a light sheet: icon and label, the whole row takes the tap. -->
    <style name="Widget.Kamleon.SheetRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Kamleon.SheetRowIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="tint">@color/kamleon_dark_grey</item>
    </style>

    <style name="Widget.Kamleon.SheetRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Kamleon.Body1</item>
        <item name="android:textColor">@color/kamleon_dark_grey</item>
    </style>

    <!-- The camera badge on the profile avatar: a small white circle with a soft shadow, like the header buttons. -->
    <style name="Widget.Kamleon.AvatarBadge" parent="CardView">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="cardCornerRadius">15dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">6dp</item>
    </style>
</resources>
