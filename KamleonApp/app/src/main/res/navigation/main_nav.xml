<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/tabFragment">

    <fragment
        android:id="@+id/tabFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.TabFragment"
        android:label="activity_tab"
        tools:layout="@layout/activity_tab">
        <action
            android:id="@+id/action_tabFragment_to_analyticFragment"
            app:destination="@id/analyticFragment" />
        <action
            android:id="@+id/action_tabFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_tabFragment_to_graphicsFragment"
            app:destination="@id/graphicsFragment" />
        <action
            android:id="@+id/action_tabFragment_to_tutorialFragment"
            app:destination="@id/tutorialFragment" />
    </fragment>

    <include app:graph="@navigation/tab_nav" />

    <!--

        <fragment
            android:id="@+id/analyticFragment"
            android:name="com.dynatech2012.kamleonuserapp.fragments.AnalyticFragment"
            android:label="activity_analytic"
            tools:layout="@layout/activity_analytic" >
            <action
                android:id="@+id/action_analyticFragment_to_homeFragment"
                app:destination="@id/homeFragment" />
            <action
                android:id="@+id/action_analyticFragment_to_graphicsFragment"
                app:destination="@id/graphicsFragment" />
            <action
                android:id="@+id/action_analyticFragment_to_settingFragment"
                app:destination="@id/settingFragment" />
        </fragment>
    -->

    <fragment
        android:id="@+id/graphicsFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.GraphicsFragment"
        android:label="activity_graphics"
        tools:layout="@layout/activity_graphics">
        <argument
            android:name="graphType"
            app:argType="string"
            android:defaultValue="hydration" />
        <action
            android:id="@+id/action_graphicsFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.SettingFragment"
        android:label="activity_setting"
        tools:layout="@layout/activity_setting">
        <action
            android:id="@+id/action_settingFragment_to_tutorialFragment"
            app:destination="@id/tutorialFragment" />

    </fragment>
    <fragment
        android:id="@+id/tutorialFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.TutorialFragment"
        android:label="fragment_tutorial"
        tools:layout="@layout/fragment_tutorial">
        <action
            android:id="@+id/action_tutorialFragment_to_tabFragment"
            app:destination="@id/tabFragment" />
        <action
            android:id="@+id/action_tutorialFragment_to_settingFragment"
            app:destination="@id/settingFragment" />

    </fragment>


</navigation>