<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_nav"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.SplashFragment"
        android:label="activity_splash"
        tools:layout="@layout/activity_splash" >
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.LoginFragment"
        android:label="activity_login"
        tools:layout="@layout/activity_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPwdFragment"
            app:destination="@id/forgotPwdFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/forgotPwdFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.ForgotPwdFragment"
        android:label="activity_forgot_pwd" >
        <action
            android:id="@+id/action_forgotPwdFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/login_nav"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>


    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.PrivacyFragment"
        android:label="activity_privacy"
        tools:layout="@layout/activity_privacy" >
        <action
            android:id="@+id/action_privacyFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_privacyFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.OnboardingFragment"
        android:label="activity_onboarding"
        tools:layout="@layout/activity_onboarding" >
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/login_nav"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.dynatech2012.kamleonuserapp.fragments.RegisterFragment"
        android:label="activity_register"
        tools:layout="@layout/activity_register" >
        <action
            android:id="@+id/action_registerFragment_to_privacyFragment"
            app:destination="@id/privacyFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/login_nav"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_hold"
            app:popEnterAnim="@anim/fade_hold"
            app:popExitAnim="@anim/fade_out" />
    </fragment>

    <!-- Startup routing (InitActivity) can land on login/register from any destination, e.g. after
         process death. They clear the whole back stack so Back from the first screen leaves the app. -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/login_nav"
        app:popUpToInclusive="true"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_hold"
        app:popEnterAnim="@anim/fade_hold"
        app:popExitAnim="@anim/fade_out" />
    <action
        android:id="@+id/action_global_registerFragment"
        app:destination="@id/registerFragment"
        app:popUpTo="@id/login_nav"
        app:popUpToInclusive="true"
        app:enterAnim="@anim/fade_in"
        app:exitAnim="@anim/fade_hold"
        app:popEnterAnim="@anim/fade_hold"
        app:popExitAnim="@anim/fade_out" />

    </navigation>