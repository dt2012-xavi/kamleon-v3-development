<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_activity"
    android:clipChildren="false"
    tools:context=".fragments.TabFragment">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_tab"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        app:defaultNavHost="false"
        app:navGraph="@navigation/tab_nav" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/layoutContentQR"
        android:background="@color/black"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Covers the preview until the camera streams, so the last frame of a previous session never
             shows. The preview itself must stay visible: its TextureView only gets a surface when drawn. -->
        <View
            android:id="@+id/cameraPreviewCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Dims the camera around the frame, so the eye goes to it. -->
        <com.dynatech2012.kamleonuserapp.views.ScanViewfinderOverlay
            android:id="@+id/scanOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/ivScanFrame"
            android:layout_width="256dp"
            android:layout_height="256dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="100dp"
            android:src="@drawable/img_camera_rect"
            android:importantForAccessibility="no"
            />

        <ProgressBar
            android:id="@+id/pbScanUploading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/white"
            android:contentDescription="@string/scan_linking"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/ivScanFrame"
            app:layout_constraintEnd_toEndOf="@id/ivScanFrame"
            app:layout_constraintTop_toTopOf="@id/ivScanFrame"
            app:layout_constraintBottom_toBottomOf="@id/ivScanFrame" />

        <TextView
            android:id="@+id/tvScanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_scan_hint"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:text="@string/scan_hint"
            android:textAppearance="@style/TextAppearance.Kamleon"
            android:textColor="@color/white"
            android:textSize="@dimen/ts_14"
            android:accessibilityLiveRegion="polite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivScanFrame" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scanner buttons, just above the tab bar: flashlight on the left, how to scan on the right. -->
    <LinearLayout
        android:id="@+id/layoutScanControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tabContainer">

        <ImageButton
            android:id="@+id/btnScanTorch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_scan_button"
            android:src="@drawable/ic_flashlight"
            android:contentDescription="@string/scan_torch_on"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnScanHelp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_scan_button"
            android:src="@drawable/ic_help"
            android:contentDescription="@string/scan_help"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- The tab bar's shadow, kept outside it so it does not show through its translucent background. -->
    <com.dynatech2012.kamleonuserapp.views.cards.ClippedShadowView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:clippedShadowRadius="@dimen/floating_surface_radius"
        app:clippedShadowElevation="@dimen/floating_surface_elevation"
        app:layout_constraintStart_toStartOf="@id/tabContainer"
        app:layout_constraintEnd_toEndOf="@id/tabContainer"
        app:layout_constraintTop_toTopOf="@id/tabContainer"
        app:layout_constraintBottom_toBottomOf="@id/tabContainer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/tabContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="24dp"
        android:paddingVertical="0dp"
        android:paddingHorizontal="0dp"
        android:weightSum="3"
        android:background="@drawable/bg_tab_shape"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/layoutTabHome"
            android:background="@drawable/bg_tab_shape"
            android:clickable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_content_height"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/tab_icon_size"
                    android:layout_height="@dimen/tab_icon_size"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_home"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Kamleon.Bold"
                    android:text="@string/tab_home"
                    android:textSize="@dimen/ts_12"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/layoutTabAnalytic"
            android:clickable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_content_height"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/tab_icon_size"
                    android:layout_height="@dimen/tab_icon_size"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_analytics"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Kamleon.Bold"
                    android:text="@string/tab_analytic"
                    android:textSize="@dimen/ts_12"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/layoutTabQr"
            android:clickable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_content_height"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/tab_icon_size"
                    android:layout_height="@dimen/tab_icon_size"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_qr"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Kamleon.Bold"
                    android:text="@string/tab_qr"
                    android:textSize="@dimen/ts_12"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>