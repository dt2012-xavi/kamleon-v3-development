<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/setting_item_padding_h"
    android:layout_gravity="center"
    android:gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:id="@+id/tvLabel"
        android:textSize="@dimen/ts_14"
        android:textAppearance="@style/TextAppearance.Kamleon.Bold"
        tools:text="NAME"
        android:textColor="@color/kamleon_secondary_grey_70"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAlignment="textEnd"
        android:paddingHorizontal="4dp"
        android:id="@+id/tvValue"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/ts_14"
        android:textAppearance="@style/TextAppearance.Kamleon.Book"
        tools:text="value"
        android:textColor="@color/kamleon_secondary_grey_70"/>

    <!-- Drawn at 75 %: the full switch is as tall as the 36dp row. The negative margin puts its
         visible right edge where the other rows' chevrons end (this row neither clips its children
         nor its padding). The whole row takes the tap, so the smaller switch is easy to hit. -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/settingItemSwitch"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:layout_marginEnd="-7dp"
        tools:checked="true"
        android:thumb="@drawable/thumb_new"
        app:trackTint="@color/switch_track_ios_color"
        app:thumbTint="@color/switch_thumb_ios_color"
        app:trackDecorationTint="@color/transparent"
        android:textOn=""
        android:textOff=""
        />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/settingItemRightArrow"
        android:paddingStart="16dp"
        android:visibility="gone"
        android:layout_gravity="center"
        android:src="@drawable/icn_setting_chevron"
        tools:ignore="UseAppTint" />

</LinearLayout>