<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Decisiones y matriz de revisión: docs/runbooks/android-build-and-manifest.md.
         CAMERA y POST_NOTIFICATIONS requieren gestionar permisos en runtime. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Cámara opcional para instalación: el resto de la app puede usarse sin escáner/cámara. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Datos de sesión y medidas: backup desactivado con exclusiones cloud/D2D explícitas.
         hardwareAccelerated habilita renderizado GPU; no soluciona errores de memoria.
         largeHeap se conserva como deuda hasta medir consumo y bitmaps. -->
    <application
        android:name=".application.MyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KamleonApp"
        tools:targetApi="31">
        <!-- tools:targetApi orienta las herramientas; el targetSdk real se define en Gradle. -->
        <!-- Valores por defecto de FCM cuando el mensaje no proporciona icono/color/canal. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/app_icon_foreground" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kamleon_blue" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/channel_id" />
        <!-- Ambas actividades: portrait es una restricción temporal de la UI actual.
             API 36 en pantallas grandes puede ignorarla: restaurar estado y probar resize/rotación.
             No añadir configChanges para ocultar recreaciones.
             singleTop reutiliza solo la instancia superior; onNewIntent debe consumir cada evento.
             adjustResize se conserva junto con el manejo de insets de BaseActivity/tema. -->
        <!-- MainActivity es interna; las entradas externas pasan por InitActivity. -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.KamleonApp"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Launcher y app links públicos; el filtro no sustituye validar la URI en código.
             Splash es el tema de arranque actual: revisar su translucidez con el flujo de login. -->
        <activity
            android:name=".activities.InitActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.KamleonApp.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${appLinkHost}"
                    android:path="/scan"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- Compartir solo Pictures/my_images mediante grants temporales; ver xml/file_paths.
             La authority debe coincidir con packageName + ".fileprovider" en MainActivity. -->
        <provider
            android:name=".provider.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Servicio de recepción FCM privado; no convertirlo en un servicio exportado. -->
        <service
            android:name=".service.NotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>