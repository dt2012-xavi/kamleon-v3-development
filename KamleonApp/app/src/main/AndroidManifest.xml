<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Decisions and review matrix: docs/runbooks/android-build-and-manifest.md.
         CAMERA and POST_NOTIFICATIONS require runtime permission handling. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera hardware is optional for installation; other features can work without scanning/photos. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Session and measurement data: backups disabled with explicit cloud/D2D exclusions.
         hardwareAccelerated enables GPU rendering; it does not fix memory errors.
         largeHeap remains as technical debt pending memory and bitmap measurements. -->
    <application
        android:name=".application.MyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KamleonApp"
        tools:targetApi="31">
        <!-- tools:targetApi guides tooling; the actual targetSdk is defined in Gradle. -->
        <!-- FCM defaults when a message does not specify an icon, color or channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/app_icon_foreground" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kamleon_blue" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/channel_id" />
        <!-- Pushes are addressed to the Firebase installation ID (saved as users/{uid}.fid), not to
             the deprecated FCM registration token: register()/onRegistered() instead of getToken(). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Both activities: portrait is a temporary constraint of the current UI.
             API 36 may ignore it on large screens: restore state and test resizing/rotation.
             Do not add configChanges to hide activity recreation.
             singleTop only reuses the top instance; onNewIntent must consume each event.
             Keep adjustResize alongside inset handling in BaseActivity/the theme. -->
        <!-- MainActivity is internal; external entry points go through InitActivity. -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.KamleonApp"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Public launcher/app links; the filter does not replace URI validation in code.
             Splash is the current startup theme: review translucency with the login flow. -->
        <activity
            android:name=".activities.InitActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.KamleonApp.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${appLinkHost}"
                    android:path="/scan"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- Share only Pictures/my_images through temporary grants; see xml/file_paths.
             The authority must match packageName + ".fileprovider" in MainActivity. -->
        <provider
            android:name=".provider.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Private FCM receiver service; do not expose it as an exported service. -->
        <service
            android:name=".service.NotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>